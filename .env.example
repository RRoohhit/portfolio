# GEMINI_API_KEY: Required for Gemini AI API calls.
# Next.js reads variables from .env.local automatically (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The production URL used for canonical links / sitemap / robots.
APP_URL="https://rohit-gupta-seo.dev"

# GEMINI_MODEL: Optional. Gemini model used by POST /api/seo/ai-optimize.
# Defaults to "gemini-3.6-flash" when unset.
GEMINI_MODEL="gemini-3.6-flash"